{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p5-generation-evaluation-record-1",
  "title": "P5 generation and human evaluation record",
  "description": "Proposed append-only metadata record. Counted records have generation status NOT_RUN and no fabricated output or scores. This is separate from the paid campaign Ledger and P1 response schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version", "record_id", "corpus_version", "evaluation_case_id",
    "created_at_utc", "run", "brief", "payload", "token_count",
    "generation", "p1_validation", "evidence_validation", "human_evaluation"
  ],
  "properties": {
    "record_version": {"const": "p5-generation-evaluation-record-1"},
    "record_id": {"$ref": "#/$defs/digest"},
    "corpus_version": {"type": "string", "minLength": 1},
    "evaluation_case_id": {"enum": ["EV-01", "EV-02", "EV-03", "EV-04", "EV-05", "EV-06", "EV-07", "EV-08-LR"]},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_id", "run_id", "manifest_sha256", "brief_run_alias", "comparison_alias", "evidence_refs"],
      "properties": {
        "fixture_id": {"enum": ["v1_1", "p5_low_risk_v1"]},
        "run_id": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/digest"},
        "brief_run_alias": {"const": "R-1"},
        "comparison_alias": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "brief": {
      "type": "object", "additionalProperties": false,
      "required": ["content_sha256", "provider_projection_sha256"],
      "properties": {
        "content_sha256": {"$ref": "#/$defs/digest"},
        "provider_projection_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["model_alias", "provider_request_sha256", "full_responses_sha256", "count_projection_sha256", "byte_length"],
      "properties": {
        "model_alias": {"type": "string", "minLength": 1},
        "provider_request_sha256": {"$ref": "#/$defs/digest"},
        "full_responses_sha256": {"$ref": "#/$defs/digest"},
        "count_projection_sha256": {"$ref": "#/$defs/digest"},
        "byte_length": {"type": "integer", "minimum": 1}
      }
    },
    "token_count": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "http_status", "request_id", "input_tokens", "timestamp_utc", "returned_usage", "returned_cost"],
      "properties": {
        "status": {"enum": ["NOT_RUN", "SUCCESS", "FAILED", "UNKNOWN"]},
        "http_status": {"type": ["integer", "null"]},
        "request_id": {"type": ["string", "null"]},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "timestamp_utc": {"type": ["string", "null"], "format": "date-time"},
        "returned_usage": {"type": ["object", "null"]},
        "returned_cost": {"type": ["object", "number", "string", "null"]}
      }
    },
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "raw_output_ref", "raw_output_sha256", "parsed_output_ref", "parsed_output_sha256", "returned_model_id", "request_id", "usage", "actual_charge_usd", "charge_source", "timestamp_utc"],
      "properties": {
        "status": {"enum": ["NOT_RUN", "IN_PROGRESS", "SUCCEEDED", "FAILED", "UNKNOWN"]},
        "raw_output_ref": {"type": ["string", "null"]},
        "raw_output_sha256": {"$ref": "#/$defs/nullable_digest"},
        "parsed_output_ref": {"type": ["string", "null"]},
        "parsed_output_sha256": {"$ref": "#/$defs/nullable_digest"},
        "returned_model_id": {"type": ["string", "null"]},
        "request_id": {"type": ["string", "null"]},
        "usage": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "total_tokens"], "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}}}]},
        "actual_charge_usd": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "charge_source": {"type": ["string", "null"]},
        "timestamp_utc": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "p1_validation": {"$ref": "#/$defs/validation"},
    "evidence_validation": {"$ref": "#/$defs/validation"},
    "human_evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewer_ids", "adjudicator_id", "scores", "critical_failures", "verdict", "review_ref"],
      "properties": {
        "status": {"enum": ["NOT_RUN", "INCOMPLETE", "COMPLETE"]},
        "reviewer_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "adjudicator_id": {"type": ["string", "null"]},
        "scores": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["factual_accuracy", "root_cause_analysis", "recommendation_quality", "decision_trade_off", "context_risk_awareness", "communication_quality"], "properties": {"factual_accuracy": {"$ref": "#/$defs/score"}, "root_cause_analysis": {"$ref": "#/$defs/score"}, "recommendation_quality": {"$ref": "#/$defs/score"}, "decision_trade_off": {"$ref": "#/$defs/score"}, "context_risk_awareness": {"$ref": "#/$defs/score"}, "communication_quality": {"$ref": "#/$defs/score"}}}]},
        "critical_failures": {"type": "array", "items": {"type": "string"}},
        "verdict": {"type": ["string", "null"]},
        "review_ref": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_digest": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "score": {"type": "integer", "minimum": 1, "maximum": 5},
    "validation": {"type": "object", "additionalProperties": false, "required": ["status", "result_ref", "checked_at_utc"], "properties": {"status": {"enum": ["NOT_RUN", "PASS", "FAIL", "INCONCLUSIVE"]}, "result_ref": {"type": ["string", "null"]}, "checked_at_utc": {"type": ["string", "null"], "format": "date-time"}}}
  }
}
